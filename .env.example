# ---------------------------------------------------------------------------
# LectureNote AI - backend environment
# Copy this file to .env and fill in your own values.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string (never commit real credentials)
MONGODB_URI=mongodb://user:password@cluster0.example.mongodb.net:27017/?ssl=true&replicaSet=atlas-xxxxxx-shard-0&authSource=admin
MONGODB_DB=lecturenote_ai

# Signing secret for JWTs - generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads / exports
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=400

# OCR (optional). Set TESSERACT_CMD to the full path of tesseract.exe on Windows
OCR_ENABLED=true
OCR_MIN_CHARS_PER_PAGE=60
TESSERACT_CMD=

# Models ---------------------------------------------------------------
# Model weights are cached inside <repo>/model/cache (HF_HOME).
BART_MODEL=facebook/bart-large-cnn
FALLBACK_MODEL=sshleifer/distilbart-cnn-12-6
PREFER_LIGHT_MODEL=false
ALLOW_MODEL_DOWNLOAD=true
WARMUP_MODELS=false
CHUNK_TOKEN_BUDGET=900
CHUNK_OVERLAP_SENTENCES=1

# Optional semantic keywords (needs keybert + sentence-transformers)
ENABLE_KEYBERT=false

ENVIRONMENT=development
LOG_LEVEL=INFO
